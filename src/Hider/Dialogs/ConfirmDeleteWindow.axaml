<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Hider.Dialogs.ConfirmDeleteWindow"
        Width="400" Height="176"
        WindowDecorations="None"
        CanResize="False"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Title="Hider">
    <!-- Design canvas 5. -->
    <Border Background="#F9F9F9" BorderBrush="#D6D6D6" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
        <DockPanel>
            <Border DockPanel.Dock="Top" Height="32" BorderBrush="#ECECEC" BorderThickness="0,0,0,1" Padding="12,0,4,0">
                <DockPanel>
                    <Button x:Name="CloseButton" DockPanel.Dock="Right" Width="28" Height="24" Padding="0" Background="Transparent" BorderThickness="0">
                        <Path Width="12" Height="12" Stroke="#444444" StrokeThickness="1.2" Data="M2.5 2.5l7 7M9.5 2.5l-7 7" />
                    </Button>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Image x:Name="AppIcon" Width="14" Height="14" RenderOptions.BitmapInterpolationMode="None" />
                        <TextBlock x:Name="TitleText" FontSize="12" Foreground="#444444" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="20,0,20,16">
                <Button x:Name="CancelButton" Height="32" Padding="16,0" Background="#FFFFFF" BorderBrush="#CFCFCF" BorderThickness="1" CornerRadius="4" VerticalContentAlignment="Center" IsCancel="True" />
                <Button x:Name="DeleteButton" Height="32" Padding="16,0" Background="#B3261E" Foreground="#FFFFFF" BorderBrush="#B3261E" BorderThickness="1" CornerRadius="4" FontWeight="Medium" VerticalContentAlignment="Center" />
            </StackPanel>
            <StackPanel Margin="20,18,20,0" Spacing="6">
                <TextBlock x:Name="MessageText" FontSize="14" FontWeight="Medium" Foreground="#1B1B1B" />
                <TextBlock x:Name="NoteText" FontSize="12" Foreground="#666666" />
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
