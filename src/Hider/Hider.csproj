<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Hider</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- LibraryImport (source-generated P/Invoke) needs unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- FR-71: generated by scripts/make_icons.py. -->
    <ApplicationIcon>Assets/hider.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Two builds, neither needs a .NET runtime on the target (proposal P-14). The default is native AOT: one native
       executable, compiled on the target's own OS (scripts/build.py makes it for the machine it runs on only).
       HiderJit=true (what the jit option of scripts/build.py passes) is the regular build: a self-contained trimmed
       single file run by the JIT, buildable for any target from any host. In both, native libs stay next to the
       executable instead of being extracted to a temp folder on every launch, and no separate symbol file is published
       (the JIT build embeds its PDB; the AOT build's native symbols go to HiderSymbolsDir, below). PublishTrimmed stays
       unconditional because it adds Microsoft.NET.ILLink.Tasks at restore time and the lock file must not depend on
       the RID. -->
  <PropertyGroup>
    <PublishTrimmed>true</PublishTrimmed>
    <DebugType>embedded</DebugType>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>
  <PropertyGroup Condition="'$(HiderJit)' != 'true'">
    <PublishAot>true</PublishAot>
  </PropertyGroup>
  <!-- PublishAot adds Microsoft.DotNet.ILCompiler at restore time, so each build has its own lock file (both written by
       scripts/update_lock_files.py, both checked by CI's format job). -->
  <PropertyGroup Condition="'$(HiderJit)' == 'true'">
    <PublishSingleFile>true</PublishSingleFile>
    <NuGetLockFilePath>packages.jit.lock.json</NuGetLockFilePath>
  </PropertyGroup>

  <!-- SelfContained without a RuntimeIdentifier is an error, so it only applies to RID-specific builds and a plain
       "dotnet build" / "dotnet test" of the solution keeps working. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" />
    <PackageReference Include="Tmds.DBus.Protocol" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Hider.Core/Hider.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tray and window icons (AppIcons). -->
    <AvaloniaResource Include="Assets/hider.ico;Assets/hider-32.png;Assets/hider-48.png" />
    <!-- Used by the Linux desktop entry written by scripts/install.py and the release installer install.sh. -->
    <None Update="Assets/hider.svg" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('linux-'))">
    <!-- PipeWire helper built by scripts/build.py (make -C native/hidercap). Optional: without it the Linux grabber
         falls back to the Screenshot portal (D-6). Loaded from next to the executable. -->
    <None Include="../../native/hidercap/out/$(RuntimeIdentifier)/libhidercap.so"
          Condition="Exists('../../native/hidercap/out/$(RuntimeIdentifier)/libhidercap.so')"
          Link="libhidercap.so" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Hider.App.Tests" />
  </ItemGroup>

  <!-- The AOT build's native symbols (Hider.dbg on Linux, Hider.pdb on Windows), kept apart from the published folder
       for reading crash dumps and stacks of a released build: scripts/build.py passes HiderSymbolsDir
       (bin/publish/<rid>-symbols), CI keeps it and the release attaches it (Hider-<version>-<rid>-symbols). -->
  <Target Name="HiderCopyAotSymbols" AfterTargets="Publish"
          Condition="'$(PublishAot)' == 'true' and '$(HiderSymbolsDir)' != ''">
    <ItemGroup>
      <_HiderAotSymbols Include="$(NativeOutputPath)$(TargetName).dbg;$(NativeOutputPath)$(TargetName).pdb" />
      <_HiderAotSymbols Remove="@(_HiderAotSymbols)" Condition="!Exists('%(FullPath)')" />
    </ItemGroup>
    <Error Condition="'@(_HiderAotSymbols)' == ''" Text="No native symbols of the AOT build in $(NativeOutputPath)." />
    <Copy SourceFiles="@(_HiderAotSymbols)" DestinationFolder="$(HiderSymbolsDir)" />
  </Target>

  <!-- SkiaSharp/HarfBuzzSharp ship ~100MB of native .pdb files for Windows; they are useless to end users. -->
  <Target Name="RemoveNativePdbFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

  <!-- Hider's license and the notices of everything bundled (MIT / BSD require them in copies): next to the executable,
       not inside the single file. -->
  <ItemGroup>
    <None Include="../../LICENSE" Link="LICENSE.txt" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="../../THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
