<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Hider</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- LibraryImport (source-generated P/Invoke) needs unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- FR-71: generated by scripts/make_icons.py. -->
    <ApplicationIcon>Assets/hider.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Self-contained trimmed single file: targets need no .NET runtime. Native libs stay next to the
       executable instead of being extracted to a temp folder on every launch. -->
  <PropertyGroup>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <!-- SelfContained without a RuntimeIdentifier is an error, so it only applies to RID-specific builds and a plain
       "dotnet build" / "dotnet test" of the solution keeps working. PublishTrimmed stays unconditional because it
       adds Microsoft.NET.ILLink.Tasks at restore time and the lock file must not depend on the RID. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" />
    <PackageReference Include="Tmds.DBus.Protocol" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Hider.Core/Hider.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tray and window icons (AppIcons). -->
    <AvaloniaResource Include="Assets/hider.ico;Assets/hider-32.png;Assets/hider-48.png" />
    <!-- Used by the Linux desktop entry written by scripts/install.py. -->
    <None Update="Assets/hider.svg" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('linux-'))">
    <!-- PipeWire helper built by scripts/build.py (make -C native/hidercap). Optional: without it the Linux grabber
         falls back to the Screenshot portal (D-6). Loaded from next to the executable. -->
    <None Include="../../native/hidercap/out/$(RuntimeIdentifier)/libhidercap.so"
          Condition="Exists('../../native/hidercap/out/$(RuntimeIdentifier)/libhidercap.so')"
          Link="libhidercap.so" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Hider.App.Tests" />
  </ItemGroup>

  <!-- SkiaSharp/HarfBuzzSharp ship ~100MB of native .pdb files for Windows; they are useless to end users. -->
  <Target Name="RemoveNativePdbFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

</Project>
