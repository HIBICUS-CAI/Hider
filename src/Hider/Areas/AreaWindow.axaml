<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:areas="using:Hider.Areas"
        x:Class="Hider.Areas.AreaWindow"
        x:DataType="areas:AreaWindow"
        WindowDecorations="None"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        CanResize="False"
        SizeToContent="Manual"
        WindowStartupLocation="Manual"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        Focusable="True"
        Title="Hider">
    <Window.Styles>
        <Style Selector="Border.handle">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.handle > Border">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#4C9AFF" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Styles>
    <Canvas x:Name="Root">
        <areas:MosaicPresenter x:Name="Pattern" />
    </Canvas>
</Window>
