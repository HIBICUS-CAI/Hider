<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Hider.Areas.EditToolbar"
             Width="436" Height="36">
    <UserControl.Styles>
        <Style Selector="Button.icon">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.text">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#CFCFCF" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Path.icon">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Stroke" Value="#1B1B1B" />
            <Setter Property="StrokeThickness" Value="1.6" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
            <Setter Property="Stretch" Value="None" />
        </Style>
    </UserControl.Styles>
    <Border Background="#F9F9F9" BorderBrush="#D6D6D6" BorderThickness="1" CornerRadius="6" BoxShadow="0 6 18 0 #59000000">
        <DockPanel Margin="6,0" VerticalAlignment="Center">
            <TextBlock x:Name="SizeText" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="0,0,4,0"
                       FontFamily="Cascadia Mono, Consolas, DejaVu Sans Mono, monospace" FontSize="12" Foreground="#444444" />
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button x:Name="PatternButton" Classes="text">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Path Classes="icon" StrokeThickness="1.4" Data="M2.5 2.5h11v11h-11zM2.5 6.2h11M2.5 9.8h11M6.2 2.5v11M9.8 2.5v11" />
                        <TextBlock x:Name="PatternLabel" VerticalAlignment="Center" FontSize="13" />
                        <Path Classes="icon" Width="12" Height="12" StrokeThickness="1.8" Data="M3 4.5l3 3 3-3" />
                    </StackPanel>
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuItem x:Name="FillItem" />
                            <MenuItem x:Name="MosaicItem" />
                            <MenuItem x:Name="GeneratedItem" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button x:Name="SettingsButton" Classes="icon">
                    <Path Classes="icon" StrokeThickness="1.5"
                          Data="M10.2 8a2.2 2.2 0 1 1-4.4 0a2.2 2.2 0 1 1 4.4 0M8 1.8v1.8M8 12.4v1.8M1.8 8h1.8M12.4 8h1.8M3.6 3.6l1.3 1.3M11.1 11.1l1.3 1.3M3.6 12.4l1.3-1.3M11.1 4.9l1.3-1.3" />
                </Button>
                <Button x:Name="RefreshButton" Classes="icon">
                    <Path Classes="icon" Data="M13 8a5 5 0 1 1-1.6-3.7M13 2.5v3h-3" />
                </Button>
                <Button x:Name="DeleteButton" Classes="icon">
                    <Path Classes="icon" Data="M3 4.5h10M6.5 4.5V3h3v1.5M4.5 4.5l.6 8.5h5.8l.6-8.5" />
                </Button>
                <Button x:Name="DoneButton" Classes="text" Padding="10,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Path Classes="icon" Stroke="#4C9AFF" StrokeThickness="2" Data="M3 8.5l3 3 7-7" />
                        <TextBlock x:Name="DoneLabel" VerticalAlignment="Center" FontSize="13" FontWeight="Medium" />
                    </StackPanel>
                </Button>
                <TextBlock x:Name="FailedText" VerticalAlignment="Center" FontSize="12" Foreground="#B3261E" IsVisible="False" />
            </StackPanel>
        </DockPanel>
    </Border>
</UserControl>
