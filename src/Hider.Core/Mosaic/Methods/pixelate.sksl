// pixelate: square cells of `block` px aligned to the area origin; each cell shows `src` sampled at the centre of its
// visible part. `src` is the pyramid level that makes one linear sample approximate the cell average (PixelateMethod).
// uniforms: block (effective size, integer px), areaSize (px), areaOrigin (px; unused: cells follow the area, not the screen)
// children: src (captured image or pyramid level, in area pixel coordinates)
uniform float block;
uniform float2 areaSize;
uniform float2 areaOrigin;
uniform shader src;

half4 main(float2 p) {
    float2 cell0 = floor(p / block) * block;
    float2 cell1 = min(cell0 + block, areaSize);
    return src.eval((cell0 + cell1) * 0.5);
}
