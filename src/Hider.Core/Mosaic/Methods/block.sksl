// block (generated): cells of `cellSize` px aligned to the area origin. Each cell is the base color shifted by
// variance * (hash - 0.5) on every channel (same shift, so the hue is kept); joints of `gap` px on the right and bottom of
// each cell stay the base color. Opaque output: the window applies the opacity.
// uniforms: cellSize (px, integer), variance (0..1), gap (px), areaSize (px), areaOrigin (px; unused, cells follow the
//           area so moving it does not change the pattern), baseColor (rgb 0..1), seed (0..65535)
// children: none
uniform float cellSize;
uniform float variance;
uniform float gap;
uniform float2 areaSize;
uniform float2 areaOrigin;
uniform float3 baseColor;
uniform float seed;

// Hash without sine (stable across backends for small integer inputs).
float hash(float2 cell) {
    float3 p3 = fract(float3(cell.xyx + seed * float3(0.731, 0.137, 0.419)) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}

half4 main(float2 p) {
    float2 cell = floor(p / cellSize);
    float2 local = p - cell * cellSize;
    if (gap > 0.0 && (local.x >= cellSize - gap || local.y >= cellSize - gap)) {
        return half4(half3(baseColor), 1);
    }
    float shift = variance * (hash(cell) - 0.5);
    return half4(half3(clamp(baseColor + shift, 0.0, 1.0)), 1);
}
