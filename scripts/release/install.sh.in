#!/bin/sh
# Install Hider @HIDER_VERSION@ (Linux x64 / arm64) from its GitHub Release. Generated by scripts/make_release.py.
#
#   sh install.sh [-d <folder>] [--jit]
#   curl -fsSL https://github.com/<owner>/<repo>/releases/latest/download/install.sh | sh
#   curl -fsSL https://github.com/<owner>/<repo>/releases/latest/download/install.sh | sh -s -- --jit
#
# Downloads Hider-@HIDER_VERSION@-<rid>.tar.gz (the native AOT build; with --jit the regular JIT build,
# Hider-@HIDER_VERSION@-<rid>-jit.tar.gz) from the release (or uses it when it sits next to this script: in the current
# directory when piped to sh), checks
# its SHA-256, copies it into the folder (default $XDG_DATA_HOME/Hider, ~/.local/share/Hider) overwriting existing files,
# and writes ~/.local/share/applications/Hider.desktop (same result as scripts/install.py on a source checkout), then
# starts Hider when there is a display, unless HIDER_NO_LAUNCH is set.
set -eu

VERSION='@HIDER_VERSION@'
BASE_URL='@HIDER_BASE_URL@'
SHA256_LINUX_X64='@HIDER_SHA256_LINUX_X64@'
SHA256_LINUX_ARM64='@HIDER_SHA256_LINUX_ARM64@'
SHA256_LINUX_X64_JIT='@HIDER_SHA256_LINUX_X64_JIT@'
SHA256_LINUX_ARM64_JIT='@HIDER_SHA256_LINUX_ARM64_JIT@'

# printf, not echo: dash's echo interprets backslashes in paths.
say() {
    printf '%s\n' "$*"
}

die() {
    say "error: $*" >&2
    exit 1
}

usage() {
    say "usage: sh install.sh [-d <folder>] [--jit]"
    say "Install Hider $VERSION. Default folder: \$XDG_DATA_HOME/Hider (~/.local/share/Hider)."
    say "The native AOT build by default; --jit installs the regular JIT build."
}

# Everything runs from main, called on the last line: piped to sh (curl ... | sh), a download cut short runs nothing.
main() {
    dest=''
    suffix=''
    while [ $# -gt 0 ]; do
        case "$1" in
            -d | --dest)
                [ $# -ge 2 ] || die "$1 needs a folder"
                dest="$2"
                shift 2
                ;;
            --jit)
                suffix='-jit'
                shift
                ;;
            -h | --help)
                usage
                exit 0
                ;;
            *)
                usage >&2
                exit 2
                ;;
        esac
    done

    [ "$(uname -s)" = Linux ] || die 'this installer is for Linux; on Windows use install.bat'
    case "$(uname -m)" in
        x86_64 | amd64) rid=linux-x64 ;;
        aarch64 | arm64) rid=linux-arm64 ;;
        *) die "unsupported architecture $(uname -m) (x86_64 and aarch64 are supported)" ;;
    esac
    # Every build named: a RID added above without its checksum here stops instead of checking against another one's.
    case "$rid$suffix" in
        linux-x64) sha256="$SHA256_LINUX_X64" ;;
        linux-arm64) sha256="$SHA256_LINUX_ARM64" ;;
        linux-x64-jit) sha256="$SHA256_LINUX_X64_JIT" ;;
        linux-arm64-jit) sha256="$SHA256_LINUX_ARM64_JIT" ;;
        *) die "no checksum for $rid$suffix in this installer" ;;
    esac

    # Not ${XDG_DATA_HOME:-$HOME/.local/share}: under set -u a missing HOME (env -i, some service managers) would stop
    # the shell with its own message, and an empty one would put the entry under /.local.
    if [ -n "${XDG_DATA_HOME:-}" ]; then
        data_home="$XDG_DATA_HOME"
    elif [ -n "${HOME:-}" ]; then
        data_home="$HOME/.local/share"
    else
        die 'neither XDG_DATA_HOME nor HOME is set: the desktop entry goes under one of them'
    fi
    # -d '' is the default folder, as an empty argument is for install.bat and scripts/install.py.
    [ -n "$dest" ] || dest="$data_home/Hider"
    case "$dest" in
        /*) ;;
        *) dest="$(pwd)/$dest" ;;
    esac

    # Files in use can not be replaced safely while Hider runs.
    if command -v pgrep > /dev/null 2>&1 && pgrep -x Hider > /dev/null 2>&1; then
        die 'Hider is running: quit it from the tray menu and run this again'
    fi

    if command -v sha256sum > /dev/null 2>&1; then
        sha256_of() { sha256sum "$1" | cut -d ' ' -f 1; }
    elif command -v shasum > /dev/null 2>&1; then
        sha256_of() { shasum -a 256 "$1" | cut -d ' ' -f 1; }
    else
        die 'sha256sum (coreutils) was not found'
    fi

    work="$(mktemp -d)"
    trap 'rm -rf "$work"' EXIT
    trap 'exit 130' INT TERM

    name="Hider-$VERSION-$rid$suffix"
    archive="$name.tar.gz"
    script_dir="$(cd "$(dirname "$0")" && pwd)"
    if [ -f "$script_dir/$archive" ]; then
        say "Using $script_dir/$archive"
        cp "$script_dir/$archive" "$work/$archive"
    else
        url="$BASE_URL/$archive"
        say "Downloading $url"
        if command -v curl > /dev/null 2>&1; then
            curl -fL --proto '=https' --proto-redir '=https' --tlsv1.2 --retry 3 -o "$work/$archive" "$url" || die "download failed: $url"
        elif command -v wget > /dev/null 2>&1; then
            wget --https-only -O "$work/$archive" "$url" || die "download failed: $url"
        else
            die 'curl or wget is needed to download Hider'
        fi
    fi

    actual="$(sha256_of "$work/$archive")"
    [ "$actual" = "$sha256" ] || die "SHA-256 mismatch for $archive (expected $sha256, got $actual)"

    tar -xzf "$work/$archive" -C "$work"
    [ -f "$work/$name/Hider" ] || die "$archive does not contain $name/Hider"

    say "Copying to $dest"
    mkdir -p "$dest"
    cp -R "$work/$name/." "$dest/" || die 'copy failed: quit Hider if it is running and run this again'
    chmod 755 "$dest/Hider"

    # Desktop Entry spec: string values escape backslashes; Exec quotes the argument, backslash-escapes " ` $ \ inside it,
    # applies the string escape on top and doubles % so it is not read as a field code (as scripts/install.py does).
    desktop_string() {
        printf '%s' "$1" | sed -e 's/\\/\\\\/g'
    }
    desktop_exec_arg() {
        quoted="\"$(printf '%s' "$1" | sed -e 's/[\\"`$]/\\&/g')\""
        desktop_string "$quoted" | sed -e 's/%/%%/g'
    }

    # A desktop entry makes Hider searchable from the Super key and pinnable to the dock. StartupWMClass matches the
    # WM_CLASS set in Program.cs so the running window groups with the pin.
    apps_dir="$data_home/applications"
    mkdir -p "$apps_dir"
    entry="$apps_dir/Hider.desktop"
    {
        echo '[Desktop Entry]'
        echo 'Type=Application'
        echo 'Name=Hider'
        echo 'Comment=画面の一部をモザイクやパターンで覆って隠す'
        printf 'Exec=%s\n' "$(desktop_exec_arg "$dest/Hider")"
        printf 'Icon=%s\n' "$(desktop_string "$dest/Assets/hider.svg")"
        echo 'Terminal=false'
        echo 'Categories=Utility;'
        echo 'StartupWMClass=Hider'
    } > "$entry"
    say "Created desktop entry: $entry"
    say "Installed Hider $VERSION to $dest"
    if [ -z "${HIDER_NO_LAUNCH:-}" ] && [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]; then
        nohup "$dest/Hider" > /dev/null 2>&1 &
        say 'Started Hider (tray icon).'
    fi
}

main "$@"
