@echo off
rem Install Hider @HIDER_VERSION@ (Windows x64) from its GitHub Release. Generated by scripts/make_release.py.
rem
rem   install.bat [folder] [--jit]
rem
rem Downloads Hider-@HIDER_VERSION@-win-x64.zip (the native AOT build; with --jit the regular JIT build,
rem Hider-@HIDER_VERSION@-win-x64-jit.zip) from the release (or uses it when it sits next to this file), checks its
rem SHA-256, copies it into the folder (default %LOCALAPPDATA%\Programs\Hider) overwriting existing files, and creates
rem the desktop shortcut Hider.lnk (same result as scripts/install.py on a source checkout), then starts Hider unless
rem HIDER_NO_LAUNCH is set. The PowerShell part below the marker line does the work, reading the arguments too; values
rem go through environment variables to avoid quoting issues. Delayed expansion is off whatever the caller's setting
rem (cmd /v:on, or the DelayedExpansion registry value): with it on, %~f0 and %~1 would lose every ! of the paths. Where
rem the registry turns it on, double-clicking this file in a folder with ! in its name still fails: the command line
rem that starts it loses the ! before this script runs. Move it to another folder, or open cmd in that folder (type cmd
rem in Explorer's address bar) and type install.bat there (README).
setlocal EnableExtensions DisableDelayedExpansion
set "HIDER_SCRIPT=%~f0"
set "HIDER_ARG1=%~1"
set "HIDER_ARG2=%~2"
set "HIDER_ARG3=%~3"
powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command "$t = [IO.File]::ReadAllText($env:HIDER_SCRIPT); $m = '#' + '#POWERSHELL#' + '#'; Invoke-Expression $t.Substring($t.IndexOf($m) + $m.Length)"
set "HIDER_EXIT=%ERRORLEVEL%"
rem Double-clicked (no arguments) and failed: keep the window open to show the error. On success it just closes.
if not "%HIDER_EXIT%"=="0" if "%~1"=="" pause
exit /b %HIDER_EXIT%

##POWERSHELL##
$ErrorActionPreference = 'Stop'
$ProgressPreference = 'SilentlyContinue'
$version = '@HIDER_VERSION@'
$baseUrl = '@HIDER_BASE_URL@'
$sha256Aot = '@HIDER_SHA256_WIN_X64@'
$sha256Jit = '@HIDER_SHA256_WIN_X64_JIT@'
$work = $null
# .NET instead of Get-FileHash / Expand-Archive / Invoke-WebRequest: those come from modules that Windows PowerShell 5.1
# fails to load when started from PowerShell 7 (its PSModulePath leaks into the child), e.g. on a CI runner.
Add-Type -AssemblyName System.IO.Compression.FileSystem
try {
    if (-not [Environment]::Is64BitOperatingSystem) { throw 'Hider needs 64-bit Windows.' }
    # The folder and --jit in either order. An empty argument is no argument (cmd unsets an empty variable): the
    # default folder, as for scripts/install.py and install.sh.
    $jit = $false
    $folder = $null
    foreach ($arg in @($env:HIDER_ARG1, $env:HIDER_ARG2, $env:HIDER_ARG3)) {
        if (-not $arg) { continue }
        if ($arg -eq '--jit') {
            $jit = $true
        } elseif ($arg.StartsWith('-')) {
            throw "unknown option $arg (usage: install.bat [folder] [--jit])."
        } elseif ($folder) {
            throw "more than one folder: $folder and $arg (usage: install.bat [folder] [--jit])."
        } else {
            $folder = $arg
        }
    }
    if ($folder) {
        $dest = [IO.Path]::GetFullPath($folder)
    } else {
        if (-not $env:LOCALAPPDATA) { throw 'LOCALAPPDATA is not set: give the install folder as the argument.' }
        $dest = Join-Path $env:LOCALAPPDATA 'Programs\Hider'
    }
    # Files in use can not be replaced while Hider runs.
    if (Get-Process -Name Hider -ErrorAction SilentlyContinue) {
        throw 'Hider is running: quit it from the tray menu and run this again.'
    }

    if ($jit) {
        $name = "Hider-$version-win-x64-jit"
        $sha256 = $sha256Jit
    } else {
        $name = "Hider-$version-win-x64"
        $sha256 = $sha256Aot
    }
    $archive = "$name.zip"
    $work = Join-Path ([IO.Path]::GetTempPath()) ('hider-install-' + [IO.Path]::GetRandomFileName())
    New-Item -ItemType Directory -Path $work | Out-Null
    $zip = Join-Path $work $archive
    $local = Join-Path (Split-Path -Parent $env:HIDER_SCRIPT) $archive
    if (Test-Path -LiteralPath $local -PathType Leaf) {
        Write-Output "Using $local"
        Copy-Item -LiteralPath $local -Destination $zip
    } else {
        $url = "$baseUrl/$archive"
        Write-Output "Downloading $url"
        # Windows PowerShell 5.1 may not offer TLS 1.2 by default.
        [Net.ServicePointManager]::SecurityProtocol = [Net.ServicePointManager]::SecurityProtocol -bor [Net.SecurityProtocolType]::Tls12
        (New-Object Net.WebClient).DownloadFile($url, $zip)
    }
    $stream = [IO.File]::OpenRead($zip)
    try {
        $actual = -join ([Security.Cryptography.SHA256]::Create().ComputeHash($stream) | ForEach-Object { $_.ToString('x2') })
    } finally {
        $stream.Dispose()
    }
    if ($actual -ne $sha256) { throw "SHA-256 mismatch for $archive (expected $sha256, got $actual)." }

    $unpacked = Join-Path $work 'unpacked'
    [IO.Compression.ZipFile]::ExtractToDirectory($zip, $unpacked)
    $src = Join-Path $unpacked $name
    if (-not (Test-Path -LiteralPath (Join-Path $src 'Hider.exe') -PathType Leaf)) { throw "$archive does not contain $name\Hider.exe." }

    Write-Output "Copying to $dest"
    New-Item -ItemType Directory -Force -Path $dest | Out-Null
    # Merge into the folder by names only (no path arithmetic, which 8.3 short temp paths would break).
    function Copy-Tree([string] $from, [string] $to) {
        foreach ($item in Get-ChildItem -LiteralPath $from -Force) {
            $target = Join-Path $to $item.Name
            if ($item.PSIsContainer) {
                New-Item -ItemType Directory -Force -Path $target | Out-Null
                Copy-Tree $item.FullName $target
            } else {
                Copy-Item -LiteralPath $item.FullName -Destination $target -Force
            }
        }
    }
    try {
        Copy-Tree $src $dest
    } catch {
        throw "Copy failed, quit Hider if it is running and run this again. $_"
    }

    $link = Join-Path ([Environment]::GetFolderPath('Desktop')) 'Hider.lnk'
    $shortcut = (New-Object -ComObject WScript.Shell).CreateShortcut($link)
    $shortcut.TargetPath = Join-Path $dest 'Hider.exe'
    $shortcut.WorkingDirectory = $dest
    $shortcut.Save()
    Write-Output "Created shortcut: $link"
    Write-Output "Installed Hider $version to $dest"
    if (-not $env:HIDER_NO_LAUNCH) {
        Start-Process -FilePath (Join-Path $dest 'Hider.exe') -WorkingDirectory $dest
        Write-Output 'Started Hider (tray icon).'
    }
} catch {
    [Console]::Error.WriteLine("error: $($_.Exception.Message)")
    exit 1
} finally {
    if ($work) { Remove-Item -LiteralPath $work -Recurse -Force -ErrorAction SilentlyContinue }
}
