<Project Sdk="Microsoft.NET.Sdk">

  <!-- S-6 (Ubuntu 26.04): ScreenCast portal + PipeWire helper. restore_token reuse, PTS ordering, frames per strip, coordinates. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Spike</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Tmds.DBus.Protocol" />
  </ItemGroup>

  <!-- The helper Hider ships (make -C native/hidercap first), so the check on a real machine tests that one. -->
  <PropertyGroup>
    <HidercapRid Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64'">linux-arm64</HidercapRid>
    <HidercapRid Condition="'$(HidercapRid)' == ''">linux-x64</HidercapRid>
    <HidercapLib>$(MSBuildThisFileDirectory)../../native/hidercap/out/$(HidercapRid)/libhidercap.so</HidercapLib>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(HidercapLib)" Condition="Exists('$(HidercapLib)')" Link="libhidercap.so" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
