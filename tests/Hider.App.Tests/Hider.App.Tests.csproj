<Project Sdk="Microsoft.NET.Sdk">

  <!-- GUI tests (test IDs GT-xx) on Avalonia.Headless with Skia rendering, so pixels can be compared without a display. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Hider.App.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- LibraryImport of the Win32 calls the Windows tests make themselves (a window of their own, a message box). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Avalonia.Headless.XUnit" />
    <PackageReference Include="Avalonia.Skia" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Hider/Hider.csproj" />
  </ItemGroup>

  <!-- libhidercap.so of this machine (make -C native/hidercap before the build) next to the tests, for the tests of the real
       helper (Platform/HidercapNativeTests, PipeWireIntegrationTests). Without it they are skipped, except on Linux CI. -->
  <PropertyGroup>
    <HidercapRid Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'X64'">linux-x64</HidercapRid>
    <HidercapRid Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64'">linux-arm64</HidercapRid>
  </PropertyGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux')) And Exists('../../native/hidercap/out/$(HidercapRid)/libhidercap.so')">
    <None Include="../../native/hidercap/out/$(HidercapRid)/libhidercap.so" Link="libhidercap.so" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Fakes live in Hider.Core.Tests/Fakes and are shared by linking the sources (a test exe cannot reference another). -->
    <Compile Include="../Hider.Core.Tests/Fakes/**/*.cs" Link="Fakes/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../Hider.Core.Tests/Imaging/**/*.cs" Link="Imaging/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
