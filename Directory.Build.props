<Project>

  <!-- Shared by every project in the solution. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Version>2.0.0</Version>
  </PropertyGroup>

  <!-- packages.lock.json is committed; CI (GitHub sets CI=true) restores in locked mode only. -->
  <PropertyGroup>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    <!-- Distro-built SDKs (e.g. Ubuntu's dotnet-sdk-10.0) add a local library-packs source whose ILLink package
         differs from the nuget.org one, which breaks the lock file hashes. Always restore from nuget.org. -->
    <DisableImplicitLibraryPacksFolder>true</DisableImplicitLibraryPacksFolder>
  </PropertyGroup>

</Project>
